{
  "name": "studentlife237",
  "version": "0.1.0",
  "private": true,
  "description": "StudentLife237: GCE revision (GCEPrep237), scholarships, jobs and guidance for Cameroonian students.",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:grant": "tsx scripts/make-admin.ts",
    "payments:smoke": "tsx --conditions=react-server scripts/campay-smoke.ts",
    "start:production": "prisma migrate deploy && next start"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.8",
    "katex": "^0.19.0",
    "next": "^15.5.28",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
