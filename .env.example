# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gce_revision?schema=public"

# Public base URL of the site (used for payment callbacks and links)
APP_URL="http://localhost:3000"

# CamPay Mobile Money (https://www.campay.net). Paste values exactly, with no quotes or brackets.
# CAMPAY_ENVIRONMENT is "demo" (test money, the default) or "live" (real money).
CAMPAY_ENVIRONMENT="demo"
CAMPAY_APP_USERNAME=""
CAMPAY_APP_PASSWORD=""
CAMPAY_WEBHOOK_KEY=""

# WhatsApp number students contact for password resets (optional; defaults to src/lib/site.ts)
SUPPORT_WHATSAPP=""

# Optional: phone numbers or emails (comma-separated) given admin access each time the
# production server starts. Register the account on the site first.
ADMIN_ACCOUNTS=""

# Optional: support email shown on the contact page
SUPPORT_EMAIL=""
